# ---------------------------------------------------------------- provider
# "anthropic" (default) or "openai-compatible"
MODEL_PROVIDER=anthropic

# --- Anthropic. Best prose. Costs money. console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
MODEL_MAP=claude-sonnet-5
MODEL_AUTHOR=claude-opus-5

# --- Google AI Studio. Free, no card. aistudio.google.com/apikey
#     Note: free-tier inputs may be used to train Google's models — fine for
#     testing on yourself, not for anyone else's life history.
# MODEL_PROVIDER=openai-compatible
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OPENAI_API_KEY=...
# MODEL_MAP=gemini-2.5-flash
# MODEL_AUTHOR=gemini-2.5-pro

# --- Groq. Free tier, very fast, open models. console.groq.com
# MODEL_PROVIDER=openai-compatible
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=gsk_...

# --- Local Ollama. Free, private, no key. Quality depends on your machine.
# MODEL_PROVIDER=openai-compatible
# OPENAI_BASE_URL=http://localhost:11434/v1
# MODEL_MAP=llama3.1
# MODEL_AUTHOR=llama3.1
